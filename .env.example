# HRMS environment variables — copy to `.env` and fill in.
#
#   cp .env.example .env
#
# settings.py loads `.env.<APP_ENV>` first, then `.env`, from the directory
# holding manage.py. Real process env vars always win over both. Django reads
# these once at startup, so RESTART THE SERVER after any change here.
#
# Every value below is optional: each has a working default in settings.py.
# Only uncomment what you actually need to change — an uncommented line with a
# placeholder value will override a good default and break things.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# APP_ENV=development                  # picks .env.development / .env.production
# DJANGO_SECRET_KEY=dev-insecure-change-me    # MUST be set to a random value in production
# DJANGO_DEBUG=true                    # set false in production
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Database (MySQL)
# ---------------------------------------------------------------------------
# DB_NAME=hrms_system
# DB_USER=root
# DB_PASSWORD=1234
# DB_HOST=localhost
# DB_PORT=3306

# ---------------------------------------------------------------------------
# Public URL — used to build links in candidate/onboarding emails, and to
# derive the LinkedIn OAuth callback below. Leave blank locally and links fall
# back to the request's own host.
# ---------------------------------------------------------------------------
# HRMS_PUBLIC_URL=https://hrms.example.com
# PUBLIC_BASE_URL=https://hrms.example.com

# ---------------------------------------------------------------------------
# LinkedIn — lets each recruiter connect their OWN LinkedIn account so the jobs
# they create are posted to their own profile (api/linkedin_oauth.py).
#
# Setup:
#   1. Create an app at https://www.linkedin.com/developers/apps
#      (requires an associated Company Page).
#   2. Products tab -> request BOTH:
#        * "Sign In with LinkedIn using OpenID Connect"  (identifies the author)
#        * "Share on LinkedIn"                           (permission to post)
#   3. Auth tab -> Authorized redirect URLs -> add, character-for-character:
#        <HRMS_PUBLIC_URL>/api/auth/linkedin/callback
#   4. Auth tab -> copy the Client ID and Primary Client Secret below.
#
# LinkedIn rejects http://localhost as a redirect URL — it requires public
# HTTPS. For local testing run a tunnel (e.g. `ngrok http 8000`), set
# HRMS_PUBLIC_URL to the tunnel URL, and register that same callback.
#
# While these are blank the feature stays dormant: /api/config reports
# linkedinConfigured=false, Settings shows "ask your administrator", the
# Post Job checkbox is hidden, and job creation works normally.
# ---------------------------------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Only needed if the callback differs from <HRMS_PUBLIC_URL>/api/auth/linkedin/callback
# LINKEDIN_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Google Sign-In — the client ID is published to the browser via /api/config
# ---------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Anthropic (resume scoring / AI helpers)
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_VALIDATION_MODEL=claude-haiku-4-5

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# JWT_ACCESS_MINUTES=60
# JWT_REFRESH_DAYS=7
# DEV_OTP_ECHO=false     # print login OTPs to the server log when email is down

# ---------------------------------------------------------------------------
# Outbound email (OTPs, candidate invites). mailer.py prefers Resend when
# RESEND_API_KEY is set, otherwise falls back to SMTP.
# ---------------------------------------------------------------------------
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=            # falls back to SMTP_FROM_EMAIL, then SMTP_USER
# RESEND_FROM_NAME=HRMS
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=                # Gmail: use a 16-char App Password
# SMTP_SECURE=                  # defaults to true when SMTP_PORT is 465
# SMTP_FROM_NAME=HRMS
# SMTP_FROM_EMAIL=              # defaults to SMTP_USER
