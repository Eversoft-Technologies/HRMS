Options -MultiViews
RewriteEngine On

# --- Allow large uploads (interview video recordings can be 20-200 MB) ------
# 524288000 bytes = 500 MB
LimitRequestBody 524288000

# --- Prevent Apache from timing out large video uploads ---------------------
TimeOut 600

# Do NOT rewrite API requests — let Passenger/Django handle them.
RewriteRule ^api(/.*)?$ - [L]

# SPA fallback: everything else that isn't a real file/dir goes to index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [QSA,L]
